QMainWindow {
    background: #1c1d20;
    color: #e6e7ea;
}

QWidget {
    color: #e6e7ea;
    background: #1c1d20;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #2c2e33;
    background: #202124;
}

QTabBar::tab {
    background: #26282c;
    color: #b3b6bd;
    padding: 8px 16px;
    border: 1px solid #2c2e33;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #202124;
    color: #ffffff;
}

QPushButton {
    background: #3b6cff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
}

QPushButton:disabled {
    background: #2b2e36;
    color: #6c6f76;
}

QPushButton#translate_btn {
    background: #10b981;
    font-weight: 600;
}

QPlainTextEdit, QLineEdit, QListWidget, QTreeWidget {
    background: #17181b;
    color: #e6e7ea;
    border: 1px solid #2c2e33;
    border-radius: 6px;
    selection-background-color: #3b6cff;
}

QLabel {
    color: #d5d7dc;
}

QLabel#prime_title {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#prime_gloss {
    font-size: 18px;
    color: #b3b6bd;
}

QLabel#prime_details {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    color: #8f939b;
}

QLabel#badge_offline,
QLabel#badge_degraded {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#badge_offline[severity="ok"]   { background: #21422f; color: #8ce5ae; }
QLabel#badge_offline[severity="info"] { background: #22303f; color: #93c5fd; }
QLabel#badge_degraded[severity="warn"]{ background: #4a1d1d; color: #fca5a5; }

QLabel#audit_tail {
    color: #6c6f76;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

QStatusBar {
    background: #17181b;
    border-top: 1px solid #2c2e33;
}
