QMainWindow {
    background: #1c1d20;
    color: #e6e7ea;
}

QWidget {
    color: #e6e7ea;
    background: #1c1d20;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #2c2e33;
    background: #202124;
}

QTabBar::tab {
    background: #26282c;
    color: #b3b6bd;
    padding: 8px 16px;
    border: 1px solid #2c2e33;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #202124;
    color: #ffffff;
}

QPushButton {
    background: #3b6cff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
}

QPushButton:disabled {
    background: #2b2e36;
    color: #6c6f76;
}

QPushButton#translate_btn {
    background: #10b981;
    font-weight: 600;
}

QPlainTextEdit, QLineEdit, QListWidget, QTreeWidget {
    background: #17181b;
    color: #e6e7ea;
    border: 1px solid #2c2e33;
    border-radius: 6px;
    selection-background-color: #3b6cff;
}

QLabel {
    color: #d5d7dc;
    background: transparent;
}

QTabWidget {
    background: transparent;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #3b6cff;
}

QPushButton:hover {
    background: #5b84ff;
}

QPushButton:pressed {
    background: #2f57d9;
}

QPushButton#translate_btn:hover {
    background: #22c58f;
}

QPushButton#translate_btn:pressed {
    background: #0ea774;
}

QPushButton#secondaryButton:hover {
    background: #33363e;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3b6cff;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3b3e45;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #4b4f58;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #3b3e45;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #4b4f58;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #8f939b;
}

QLabel#statusLine {
    font-size: 12px;
    color: #8f939b;
}

QLabel#countLabel {
    font-size: 12px;
    color: #8f939b;
}

QLabel#fieldLabel {
    font-size: 12px;
    font-weight: 500;
    color: #b3b6bd;
}

QFrame#card {
    background: #202124;
    border: 1px solid #2c2e33;
    border-radius: 10px;
}

QLabel#resultStatus {
    font-size: 13px;
    font-weight: 600;
    color: #8ce5ae;
}

QLabel#resultStatus[severity="warn"] {
    color: #fca5a5;
}

QLabel#surfaceText {
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#spellHint {
    font-size: 12px;
    color: #fcd34d;
    background: #2d2611;
    border: 1px solid #5c4a14;
    border-radius: 6px;
    padding: 6px 10px;
}

QLabel#metaKey {
    font-size: 10px;
    font-weight: 600;
    color: #6c6f76;
}

QLabel#metaValue {
    font-size: 13px;
    color: #e6e7ea;
}

QLabel#factKey {
    font-size: 12px;
    color: #8f939b;
}

QLabel#factValue {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 13px;
    color: #e6e7ea;
}

QWidget#entryRow {
    background: transparent;
}

QFrame#entryCard {
    background: #202124;
    border: 1px solid #2c2e33;
    border-radius: 8px;
}

QFrame#entryCard:hover {
    border: 1px solid #3b3e45;
}

QLabel#entryTitle {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#entryGloss {
    font-size: 13px;
    color: #b3b6bd;
}

QLabel#entryMeta {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    color: #6c6f76;
}

QListWidget#entryList {
    background: #17181b;
    border: 1px solid #2c2e33;
    border-radius: 8px;
    padding: 6px 10px;
}

QListWidget#entryList::item {
    background: transparent;
    border: none;
}

QLabel#prime_title {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#prime_gloss {
    font-size: 18px;
    color: #b3b6bd;
}

QLabel#prime_details {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    color: #8f939b;
}

QLabel#badge_offline,
QLabel#badge_degraded {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#badge_offline[severity="ok"]   { background: #21422f; color: #8ce5ae; }
QLabel#badge_offline[severity="info"] { background: #22303f; color: #93c5fd; }
QLabel#badge_degraded[severity="warn"]{ background: #4a1d1d; color: #fca5a5; }

QLabel#audit_tail {
    color: #6c6f76;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

QStatusBar {
    background: #17181b;
    border-top: 1px solid #2c2e33;
}

/* --- Settings tab ------------------------------------------------------ */

QComboBox, QSpinBox {
    background: #17181b;
    color: #e6e7ea;
    border: 1px solid #2c2e33;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 22px;
}

QComboBox QAbstractItemView {
    background: #17181b;
    color: #e6e7ea;
    selection-background-color: #3b6cff;
}

QCheckBox {
    spacing: 8px;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QListWidget#settingsCategories {
    padding: 6px;
}

QListWidget#settingsCategories::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QListWidget#settingsCategories::item:selected {
    background: #26282c;
    color: #ffffff;
}

QLabel#settingsHeading {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
}

QFrame#settingRow, QFrame#addForm {
    background: #202124;
    border: 1px solid #2c2e33;
    border-radius: 8px;
}

QLabel#settingTitle {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#settingName {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    color: #8f939b;
}

QLabel#settingDesc {
    color: #b3b6bd;
}

QLabel#settingMeta {
    color: #8f939b;
    font-size: 12px;
}

QLabel#settingNote {
    color: #93c5fd;
    font-size: 12px;
}

QLabel#settingError {
    color: #fca5a5;
    font-size: 12px;
}

QLabel#settingRevealed {
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: #17181b;
    border: 1px solid #b45309;
    border-radius: 6px;
    padding: 6px 8px;
    color: #fde68a;
}

QLabel#settingBadge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    background: #26282c;
    color: #9ca3af;
}

QLabel#settingBadge[state="unsaved"] { background: #4a3513; color: #fcd34d; }
QLabel#settingBadge[state="shell"]   { background: #22303f; color: #93c5fd; }
QLabel#settingBadge[state="saved"]   { background: #21422f; color: #8ce5ae; }
QLabel#settingBadge[state="locked"]  { background: #3a3d44; color: #d5d7dc; }

QFrame#restartBanner {
    background: #22303f;
    border: 1px solid #1e40af;
    border-radius: 8px;
    padding: 8px;
}

QPushButton#secondaryButton {
    background: #2b2e36;
    color: #e6e7ea;
}

QPushButton#secondaryButton:disabled {
    background: #22242a;
    color: #5c5f66;
}

QHeaderView {
    background: #26282c;
    color: #d5d7dc;
}

QHeaderView::section {
    background: #26282c;
    color: #d5d7dc;
    border: none;
    border-right: 1px solid #2c2e33;
    padding: 6px 8px;
}

QTreeWidget::item {
    padding: 2px 0;
}

QTreeWidget {
    alternate-background-color: #202124;
}
