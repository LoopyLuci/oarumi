#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ -d .venv ]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi

echo "[pre-commit] ruff"
ruff check .

echo "[pre-commit] black --check"
black --check .

echo "[pre-commit] schema validation"
python tools/validate_schemas.py --all

echo "[pre-commit] ok"
